# Cargo build output
/target
**/target

# Rustfmt backup files
**/*.rs.bk

# MSVC Windows builds of rustc generate these for debugging
*.pdb
*.run

# cargo mutants — mutation testing data
**/mutants.out*/

# Meson build directories. Convention is `builddir`; tolerate variants.
/builddir
/build
/_build

# The CI packaging-validator build dir name (meson setup build-validate).
/build-validate

# flatpak-builder state from a bare run at the repo root (the manifest is
# data/, so this only appears when the command is invoked from .).
/.flatpak-builder/

# Memory-diagnostic capture file produced by `--debug` runs.
debug-memory.log

# Local real-album import test data (copied from the music library, not committed).
# Used to exercise the Phase 2d import pipeline against real files.
/testdata/

# Editor / OS detritus
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Competitor / reference clones for UI research (local only)
/.repos/
